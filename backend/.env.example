# Server
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/ukiz_db

# Auth - JWT & Admin (email/password)
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
ADMIN_EMAIL=admin@ukiz.com
ADMIN_PASSWORD=admin123
VITE_APP_ID=ukiz-app

# Storage / S3 (optional - for media uploads)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Payment - SSLCommerz Sandbox
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_SANDBOX=true
